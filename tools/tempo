class Filter(object):
    def __init__(self, threads=None, focus=None, depth=None, min_ms=None):
        self.threads_re = re.compile(threads) if threads else None
        self.focus = focus.strip("/") if focus else None
        self.depth = depth
        self.min_us = int(round(min_ms * 1000)) if min_ms else 0

    @property
    def active(self):
        return bool(self.threads_re or self.focus or self.depth is not None or self.min_us)

    def matches_focus(self, s):
        f = self.focus
        return s.path == f or s.key == f or s.key.endswith("/" + f)

    def apply(self, trace):
        """Return (visible set of span ids, focus roots)."""
        roots = []
        if self.focus:
            for s in trace.spans:
                if self.matches_focus(s) and not any(a in roots for a in ancestors(s)):
                    roots.append(s)
        else:
            roots = [trace.root] if trace.root else []
        vis = set()
        for r in roots:
            base = r.depth
            stack = [r]
            while stack:
                s = stack.pop()
                if self.depth is not None and s.depth - base > self.depth:
                    continue
                if self.min_us and s.end - s.start < self.min_us and s is not r:
                    continue
                if not self.threads_re or self.threads_re.search(thread_filter_label(trace, s)):
                    vis.add(s.id)
                stack.extend(s.children)
        return vis, roots


def thread_filter_label(trace, s):
    if s.not_run or s.thread < 0:
        return s.pool + "-*"
    return trace.threads[s.thread]


def ancestors(s):
    out = []
    p = s.parent
    while p is not None:
        out.append(p)
        p = p.parent
    return out


