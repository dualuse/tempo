class UsageError(Exception):
    pass


EPILOG = """\
input:
  curl -si "$URL" | tempo            the Tempo-Timing (or Tempo-Link) line of curl -i
  pbpaste | tempo --tree             a bare value (v1;...), wrapped lines are fine
  tempo 'https://.../tempo/#t=z...'  a Tempo-Link URL (argument, file, stdin, log
                                     line); ?t=z... in the query is read too
  tempo response.json                JSON with a tempo object anywhere
  Quote a value or link on the command line or pipe it: ; * ~ ^ & are shell syntax.
  With both headers in one response, Tempo-Timing wins (a warning if they
  disagree). A link's &c= trace is what --diff compares with when no OTHER is given.

web viewer (Tempo Timeline):
  --to link                          print the Tempo-Link URL of the trace
  --open                             open the trace in the browser; with --diff,
                                     both traces; with --tree, --agg, --pools,
                                     --critical or --diff, on that tab
  --base URL                         another viewer copy (default $TEMPO_LINK_BASE
                                     or https://dualuse.de/tempo/)
  The trace travels in the #fragment, which the browser never sends to the
  server; --open only starts the local browser. Nothing else is sent anywhere.

views (default: lanes per thread, grouped into pools):
  --tree, --agg, --pools, --findings, --critical, --diff [OTHER], --stats FILES...

layout:
  Lanes and charts fit --width down to 40 columns (a smaller width is
  raised to it). Tables never cut a number; they shorten names and paths,
  wrap attributes and span text, and split wide tables into stacked blocks.
  So they have a floor of their own: about 80 columns for --tree, 70 for
  --critical and 60 for the other tables; narrower, their lines run over.

exit status: 0 ok, 1 malformed or (with --check) truncated input, 2 usage error.
"""


def build_parser():
    ap = argparse.ArgumentParser(
        prog="tempo", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Read Tempo-Timing values in the terminal (format: FORMAT.md).",
        epilog=EPILOG)
    ap.add_argument("inputs", nargs="*", metavar="FILE",
                    help="input files or Tempo-Link URLs; none or '-' reads stdin")
    v = ap.add_argument_group("views").add_mutually_exclusive_group()
    v.add_argument("--tree", action="store_true",
                   help="indented tree: start, wait, duration, self, cpu, off-cpu, attributes")
    v.add_argument("--agg", action="store_true",
                   help="per path: count, sum, self, min, max, wait sum/max, cpu")
    v.add_argument("--pools", action="store_true",
                   help="this request's share of each pool over time, with submit gauges")
    v.add_argument("--findings", action="store_true",
                   help="stragglers, never started, open, failed, queue waits, off-CPU")
    v.add_argument("--critical", action="store_true",
                   help="critical path across handoffs, wait vs run per hop")
    v.add_argument("--diff", metavar="OTHER", nargs="?", const="",
                   help="per-path change from the input (A) to OTHER (B), a file or link; "
                        "without OTHER, to the &c= trace of the input link")
    v.add_argument("--stats", nargs="*", metavar="FILE",
                   help="per-path count and p50/p95/max of sum, self, wait over many traces")
    v.add_argument("--to", choices=["json", "chrome", "folded", "link"],
                   help="convert: JSON form, Chrome trace events (Perfetto), collapsed stacks, "
                        "Tempo-Link URL")
    v.add_argument("--check", action="store_true",
                   help="validate only; exit 1 on a malformed or truncated value")
    f = ap.add_argument_group("filters")
    f.add_argument("--threads", metavar="REGEX", help="only spans on threads matching REGEX")
    f.add_argument("--focus", metavar="PATH",
                   help="only the subtree(s) at PATH, e.g. rerank or rerank/load")
    f.add_argument("--depth", type=int, metavar="N", help="at most N levels below the root/focus")
    f.add_argument("--min-ms", type=float, metavar="X",
                   help="hide spans (and their subtrees) shorter than X ms")
    w = ap.add_argument_group("web viewer")
    w.add_argument("--open", action="store_true",
                   help="open the trace in the web viewer (the local browser; the trace stays "
                        "in the link fragment)")
    w.add_argument("--base", metavar="URL",
                   help="viewer URL for --to link and --open (default: $TEMPO_LINK_BASE or %s)"
                        % DEFAULT_BASE)
    o = ap.add_argument_group("layout")
    o.add_argument("--width", type=int, metavar="N",
                   help="output width (default: terminal; at least %d)" % MIN_WIDTH)
    o.add_argument("--no-color", action="store_true", help="no ANSI colours (also NO_COLOR)")
    o.add_argument("--color", action="store_true", help="ANSI colours even when not a terminal")
    o.add_argument("--ascii", action="store_true", help="ASCII instead of Unicode block characters")
    ap.add_argument("--version", action="version", version="tempo " + VERSION)
    return ap


def _read(name, stdin):
    if name == "-":
        data = stdin.read()
        if isinstance(data, bytes):
            data = data.decode("utf-8", "replace")
        return data
    with open(name, "rb") as fh:
        return fh.read().decode("utf-8", "replace")


def _read_arg(name, stdin):
    """A file, '-' for stdin, or a Tempo-Link given as the argument itself."""
    if name != "-" and not os.path.exists(name) and LINK_TOKEN_RE.search(name):
        return name
    return _read(name, stdin)


OPEN_TABS = (("tree", "tree"), ("agg", "agg"), ("pools", "pools"), ("critical", "critical"), ("diff", "diff"))


def run(argv, stdin=None, stdout=None, stderr=None, env=None, isatty=None):
    """Entry point; returns the exit status. Streams and environment are injectable for tests."""
    stdin = stdin if stdin is not None else getattr(sys.stdin, "buffer", sys.stdin)
    stdout = stdout if stdout is not None else sys.stdout
    stderr = stderr if stderr is not None else sys.stderr
    env = os.environ if env is None else env
    if isatty is None:
        isatty = hasattr(stdout, "isatty") and stdout.isatty()
    ap = build_parser()
    try:
        args = ap.parse_args(argv)
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else 2

    def err(msg):
        stderr.write("tempo: %s\n" % msg)

    color = False
    if args.color:
        color = True
    elif not args.no_color and not env.get("NO_COLOR") and env.get("TERM") != "dumb":
        color = isatty
    if args.no_color:
        color = False
    if args.width:
        width = args.width
    elif isatty:
        width = shutil.get_terminal_size((100, 24)).columns
    else:
        try:
            width = int(env.get("COLUMNS") or 100)
        except ValueError:
            width = 100
    if args.width and args.width < MIN_WIDTH:
        err("--width %d is below the minimum of %d; using %d" % (args.width, MIN_WIDTH, MIN_WIDTH))
    width = max(MIN_WIDTH, width)
    p = Painter(color, args.ascii)
    try:
        flt = Filter(args.threads, args.focus, args.depth, args.min_ms)
    except re.error as e:
        err("bad --threads expression: %s" % e)
        return 2

    if args.open and (args.to or args.check or args.stats is not None):
        err("--open cannot be combined with --to, --check or --stats")
        return 2
    try:
        base = check_base(args.base if args.base is not None else env.get("TEMPO_LINK_BASE") or DEFAULT_BASE)
    except ValueError as e:
        err(str(e))
        return 2

    names = list(args.inputs)
    if args.stats is not None:
        names.extend(args.stats)
    if not names:
        if hasattr(sys.stdin, "isatty") and stdin is getattr(sys.stdin, "buffer", None) and sys.stdin.isatty():
            err("no input: pipe a trace in or name a file (tempo --help)")
            return 2
        names = ["-"]

    loaded = []
    for name in names:
        try:
            text = _read_arg(name, stdin)
        except (IOError, OSError) as e:
            err("%s: %s" % (name, e.strerror or e))
            return 1
        label = "stdin" if name == "-" else "link" if text is name else name
        loaded.extend(load_text(text, label, err))

    if args.check:
        status = 0
        for label, t in loaded:
            if isinstance(t, Exception):
                err("%s: %s" % (label, t))
                status = 1
            elif t.truncated:
                err("%s: truncated: the value was cut (%d spans survive)" % (label, len(t.spans)))
                status = 1
            else:
                stdout.write("ok  %s: %d spans, %d threads%s\n" % (
                    label, len(t.spans), len(t.threads),
                    (", %d folded, %d dropped" % (t.folded, t.dropped)) if (t.folded or t.dropped) else ""))
        return status

    if args.stats is not None:
        traces = []
        status = 0
        for label, t in loaded:
            if isinstance(t, Exception):
                err("%s: %s (skipped)" % (label, t))
                status = 1
            else:
                traces.append(t)
        if not traces:
            err("no valid traces")
            return 1
        lines = view_stats(traces, flt, p, width)
        stdout.write("\n".join(line.rstrip(" ") for line in lines) + "\n")
        return status

    label, trace = loaded[0]
    if isinstance(trace, Exception):
        err("%s: %s" % (label, trace))
        return 1
    if len(loaded) > 1:
        err("%s: %d traces found, showing the first (--stats reads all)" % (label, len(loaded)))
    other = None
    if args.diff is not None:
        if args.diff:
            try:
                otext = _read_arg(args.diff, stdin)
            except (IOError, OSError) as e:
                err("%s: %s" % (args.diff, e.strerror or e))
                return 1
            olabel, other = load_text(otext, "link" if otext is args.diff else args.diff, err)[0]
        elif trace.link_compare:
            olabel = label + " (c=)"
            try:
                other = Trace(decode(unpack_value(trace.link_compare)), olabel)
                other.value, other.link_compare = strip_ws(unpack_value(trace.link_compare)), None
            except TempoFormatError as e:
                other = e
        else:
            err("--diff needs OTHER, or an input link that carries a second trace (&c=)")
            return 2
        if isinstance(other, Exception):
            err("%s: %s" % (olabel, other))
            return 1

    if args.to == "link" or args.open:
        try:
            value = trace.value or encode(trace.doc)
            if other is not None:
                compare = other.value or encode(other.doc)
            elif trace.link_compare:
                compare = unpack_value(trace.link_compare)    # keep the pair of the input link
            else:
                compare = None
        except TempoFormatError as e:
            err("%s: %s" % (label, e))
            return 1
        except ValueError as e:
            err("%s: cannot be written as a header value: %s" % (label, e))
            return 1
        tab = next((t for opt, t in OPEN_TABS if getattr(args, opt)), None) if args.open else None
        if args.diff is not None:
            tab = "diff"
        url = encode_link(value, base, compare, tab)
        stdout.write(url + "\n")
        if args.open and not webbrowser.open(url):
            err("could not start a web browser; open the link above yourself")
            return 1
        return 0

    try:
        if args.to == "json":
            stdout.write(dump_json(trace.doc))
            return 0
        if args.to == "chrome":
            stdout.write(to_chrome(trace))
            return 0
        if args.to == "folded":
            stdout.write(to_folded(trace))
            return 0
        if other is not None:
            lines = view_diff(trace, other, flt, p, width)
        elif args.tree:
            lines = view_tree(trace, flt, p, width)
        elif args.agg:
            lines = view_agg(trace, flt, p, width)
        elif args.pools:
            lines = view_pools(trace, flt, p, width)
        elif args.findings:
            lines = view_findings(trace, flt, p, width)
        elif args.critical:
            lines = view_critical(trace, flt, p, width)
        else:
            lines = view_lanes(trace, flt, p, width)
    except UsageError as e:
        err(str(e))
        return 2
    stdout.write("\n".join(line.rstrip(" ") for line in "\n".join(lines).split("\n")) + "\n")
    return 0


def main():
    try:
        code = run(sys.argv[1:])
        sys.stdout.flush()
    except BrokenPipeError:
        try:
            sys.stdout = None
        finally:
            code = 0
    except KeyboardInterrupt:
        code = 130
    sys.exit(code)


if __name__ == "__main__":
    main()
