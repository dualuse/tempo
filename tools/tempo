def to_chrome(trace):
    """Chrome Trace Event JSON (opens in Perfetto and chrome://tracing)."""
    ev = []
    pid = 1
    root_name = trace.root.name if trace.root else "trace"
    ev.append({"ph": "M", "pid": pid, "tid": 0, "name": "process_name", "args": {"name": root_name}})
    tids = {}
    for i, t in enumerate(trace.threads):
        tids[("t", i)] = i + 1
        ev.append({"ph": "M", "pid": pid, "tid": i + 1, "name": "thread_name", "args": {"name": t}})
        ev.append({"ph": "M", "pid": pid, "tid": i + 1, "name": "thread_sort_index",
                   "args": {"sort_index": i}})
    nxt = len(trace.threads) + 1
    for s in trace.spans:
        if s.lane[0] == "mixed":
            key = ("agg", s.id)
            tids[key] = nxt
            ev.append({"ph": "M", "pid": pid, "tid": nxt, "name": "thread_name",
                       "args": {"name": "%s-* %s ×%d" % (s.pool, s.name, s.agg["count"])}})
            ev.append({"ph": "M", "pid": pid, "tid": nxt, "name": "thread_sort_index",
                       "args": {"sort_index": nxt}})
            nxt += 1

    def tid_of(s):
        if s.lane[0] == "mixed":
            return tids[("agg", s.id)]
        if s.thread >= 0:
            return tids[("t", s.thread)]
        return 0

    for s in trace.spans:
        args = {"path": s.path, "id": s.id}
        if s.handoff:
            args["wait_us"] = s.wait
        if s.cpu is not None:
            args["cpu_us"] = s.cpu
        if s.flags:
            args["flags"] = s.flags
        if s.attrs:
            args["attrs"] = s.attrs
        if s.agg:
            args["agg"] = s.agg
        cat = "aggregate" if s.agg else ("handoff" if s.handoff else "span")
        if s.not_run:
            e = None
        elif s.agg:
            e = {"ph": "X", "pid": pid, "tid": tid_of(s), "ts": s.start, "dur": s.agg["extent"],
                 "name": "%s ×%d" % (s.name, s.agg["count"]), "cat": cat, "args": args}
        else:
            e = {"ph": "X", "pid": pid, "tid": tid_of(s), "ts": s.run_start, "dur": s.dur,
                 "name": s.name, "cat": cat, "args": args}
        if e is not None:
            if "f" in s.flags:
                e["cname"] = "terrible"
            ev.append(e)
        if (s.not_run or (s.handoff and not s.agg)) and s.parent is not None:
            src = tid_of(s.parent)
            qid = "q%d" % s.id
            qname = "%s (%s)" % (span_label(s, UNI), "never started" if s.not_run else "queued")
            ev.append({"ph": "b", "pid": pid, "tid": src, "ts": s.start, "id": qid, "cat": "queue",
                       "name": qname, "args": args})
            ev.append({"ph": "e", "pid": pid, "tid": src, "ts": s.end if s.not_run else s.run_start,
                       "id": qid, "cat": "queue", "name": qname})
            if not s.not_run:
                ev.append({"ph": "s", "pid": pid, "tid": src, "ts": s.start, "id": s.id,
                           "cat": "handoff", "name": "handoff"})
                ev.append({"ph": "f", "bp": "e", "pid": pid, "tid": tid_of(s), "ts": s.run_start,
                           "id": s.id, "cat": "handoff", "name": "handoff"})
    other = {"source": "tempo", "label": trace.label, "folded": trace.folded,
             "dropped": trace.dropped, "truncated": trace.truncated}
    if trace.wall is not None:
        other["wall_ms"] = trace.wall
    return json.dumps({"traceEvents": ev, "displayTimeUnit": "ms", "otherData": other},
                      ensure_ascii=False, indent=None, separators=(",", ":")) + "\n"


def to_folded(trace):
    """Collapsed stacks: `root;child;leaf <self µs>` (thread time, queue waits excluded)."""
    totals = {}
    order = []
    stacks = {}
    for s in trace.spans:
        frame = s.name.replace(";", ":").replace("\n", " ")
        stacks[s.id] = frame if s.parent is None else stacks[s.parent.id] + ";" + frame
        v = s.self_time
        if v <= 0:
            continue
        k = stacks[s.id]
        if k not in totals:
            totals[k] = 0
            order.append(k)
        totals[k] += v
    return "".join("%s %d\n" % (k, totals[k]) for k in order)


