#!/usr/bin/env python3
"""tempo - read Tempo-Timing values in the terminal.

Reads a trace from files or stdin: `curl -i` output (the Tempo-Timing or Tempo-Link
header line, also folded or wrapped over several lines), a bare header value
starting with `v1;`, a Tempo-Link URL (`...#t=z....`, also inside a log line or as
an argument), or a JSON document holding a tempo object anywhere (for example under
"info"). The format is specified in FORMAT.md.

Python 3.8+, standard library only, one file.
"""

import argparse
import base64
import datetime
import json
import math
import os
import re
import shutil
import sys
import textwrap
import webbrowser
import zlib

VERSION = "1.0"
MIN_WIDTH = 40    # narrowest output: the lanes need a label column and a time axis

# ======================================================================
# Decoder (FORMAT.md section 6; mirrors tools/tempo_ref.py)
# ======================================================================

ALPHABET = frozenset("0123456789abcdefghijklmnopqrstuvwxyz"
                     "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                     "./:;=@~*+^_%-")
WHITESPACE = "\t\n\x0b\x0c\r "
FLAG_ORDER = "fconwm"
MAX_DEPTH = 35

RECORD_RE = re.compile(
    r"^([0-9a-z])([0-9a-z]+)\.([0-9a-z]+)\.([0-9a-z]+)"
    r"(?:@([0-9a-z]+|_))?"
    r"(?:~([0-9a-z]+)(?:\.([0-9a-z]+))?)?"
    r"(?:\*([0-9a-z]+))?"
    r"(?:\+([0-9a-z]+)\.([0-9a-z]+)\.([0-9a-z]+)\.([0-9a-z]+)\.([0-9a-z]+))?"
    r"(?:\^([a-z]+))?"
    r"((?::[0-9a-z]+=-?[0-9]+(?:\.[0-9]+)?)*)$")
ATTR_RE = re.compile(r":([0-9a-z]+)=(-?[0-9]+(?:\.[0-9]+)?)")
B36_RE = re.compile(r"^[0-9a-z]+$")
NAME_RE = re.compile(r"^(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+$")
FIELD_ORDER = ["w", "x", "l", "T", "N", "S"]


class TempoFormatError(ValueError):
    """A value that must be rejected; `code` is one of the E_* codes of FORMAT.md."""

    def __init__(self, code, message):
        ValueError.__init__(self, "%s: %s" % (code, message))
        self.code = code


def strip_ws(value):
    return "".join(ch for ch in value if ch not in WHITESPACE)


def b36(text, what="number"):
    if not B36_RE.match(text):
        raise TempoFormatError("E_FIELD", "bad base-36 %s %r" % (what, text))
    return int(text, 36)


def decode_name(text):
    if not text:
        raise TempoFormatError("E_NAME", "empty name")
    if not NAME_RE.match(text):
        raise TempoFormatError("E_NAME", "bad name %r" % text)
    raw = bytearray()
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == "%":
            raw.append(int(text[i + 1:i + 3], 16))
            i += 3
        else:
            raw.append(0x20 if ch == "_" else ord(ch))
            i += 1
    try:
        return bytes(raw).decode("utf-8")
    except UnicodeDecodeError:
        raise TempoFormatError("E_NAME", "name %r is not valid UTF-8" % text)


def decode_number(text):
    if "." in text:
        v = float(text)
        return 0.0 if v == 0 else v
    v = int(text)
    return 0 if v == 0 else v


def decode(value):
    """Decode a Tempo-Timing value (whitespace allowed) into the JSON form (a dict)."""
    v = strip_ws(value)
    if not v.startswith("v1;"):
        raise TempoFormatError("E_VERSION", "value does not start with 'v1;'")
    for ch in v:
        if ch not in ALPHABET:
            raise TempoFormatError("E_CHAR", "character %r outside the alphabet" % ch)
    fields = v[3:].split(";")
    expected = None
    cut = False
    last = fields[-1]
    if last.startswith("e=") and B36_RE.match(last[2:]):
        expected = int(last[2:], 36)
        fields = fields[:-1]
    else:
        cut = True
        if last in ("", "e", "e="):
            fields = fields[:-1]
        if not fields or not fields[-1].startswith("S="):
            raise TempoFormatError("E_CUT", "value cut before the span list")
    seen = {}
    pos = -1
    for f in fields:
        if "=" not in f:
            raise TempoFormatError("E_FIELD", "field %r has no '='" % f)
        key, val = f.split("=", 1)
        if key not in FIELD_ORDER:
            raise TempoFormatError("E_FIELD", "unknown field %r" % key)
        idx = FIELD_ORDER.index(key)
        if idx <= pos:
            raise TempoFormatError("E_FIELD", "field %r duplicated or out of order" % key)
        pos = idx
        seen[key] = val
    for key in ("T", "N", "S"):
        if key not in seen:
            raise TempoFormatError("E_MISSING", "required field %s= is missing" % key)
    doc = {"v": 1, "unit": "us"}
    if "w" in seen:
        doc["wall"] = b36(seen["w"], "w=")
    folded = dropped = 0
    if "x" in seen:
        parts = seen["x"].split(".")
        if len(parts) != 2:
            raise TempoFormatError("E_FIELD", "x= must be folded.dropped")
        folded, dropped = b36(parts[0], "x="), b36(parts[1], "x=")
    doc["folded"] = folded
    doc["dropped"] = dropped
    threads = [decode_name(t) for t in seen["T"].split(":")]
    names = [decode_name(n) for n in seen["N"].split(":")]
    live = []
    if "l" in seen:
        for p in seen["l"].split("."):
            i = b36(p, "l=")
            if i >= len(threads):
                raise TempoFormatError("E_INDEX", "l= thread index %d out of range" % i)
            live.append(i)
    doc["threads"] = threads
    doc["live"] = live
    records = seen["S"].split("/")
    truncated = cut or (expected is not None and expected != len(records))
    if truncated:
        records = records[:-1]
    doc["truncated"] = truncated
    doc["spans"] = _decode_records(records, names, threads)
    return doc


def _decode_records(records, names, threads):
    spans = []
    cur = [0] * (MAX_DEPTH + 2)
    path = [None] * (MAX_DEPTH + 1)
    prev_depth = -1
    prev_agg = False
    for i, rec in enumerate(records):
        m = RECORD_RE.match(rec)
        if not m:
            raise TempoFormatError("E_RECORD", "record %d %r is malformed" % (i, rec))
        (depth_s, name_s, delta_s, dur_s, thr_s, wait_s, wmax_s, cpu_s,
         a_count, a_min, a_max, a_ext, a_at, flags_s, attrs_s) = m.groups()
        depth = int(depth_s, 36)
        is_agg = a_count is not None
        if i == 0:
            if depth != 0:
                raise TempoFormatError("E_ROOT", "first record has depth %d" % depth)
            if thr_s is not None or wait_s is not None or is_agg:
                raise TempoFormatError("E_ROOT", "root record carries @, ~ or +")
            if int(delta_s, 36) != 0:
                raise TempoFormatError("E_ROOT", "root startDelta is not 0")
        else:
            if depth == 0:
                raise TempoFormatError("E_ROOT", "record %d is a second root" % i)
            if depth > prev_depth + 1:
                raise TempoFormatError("E_DEPTH", "record %d jumps from depth %d to %d"
                                       % (i, prev_depth, depth))
            if prev_agg and depth > prev_depth:
                raise TempoFormatError("E_AGG", "record %d is a child of an aggregate" % i)
        name_idx = int(name_s, 36)
        if name_idx >= len(names):
            raise TempoFormatError("E_INDEX", "record %d name index %d out of range" % (i, name_idx))
        start = cur[depth] + int(delta_s, 36)
        cur[depth] = start
        cur[depth + 1] = start
        parent = path[depth - 1] if depth > 0 else None
        if thr_s is None:
            thread = parent["thread"] if parent is not None else 0
        elif thr_s == "_":
            if not is_agg:
                raise TempoFormatError("E_AGG", "record %d: '@_' on a non-aggregate" % i)
            thread = -1
        else:
            thread = int(thr_s, 36)
            if thread >= len(threads):
                raise TempoFormatError("E_INDEX", "record %d thread index %d out of range" % (i, thread))
        span = {"id": i, "parent": parent["id"] if parent is not None else -1,
                "name": names[name_idx], "start": start, "dur": int(dur_s, 36),
                "thread": thread}
        if wait_s is not None and not is_agg:
            if wmax_s is not None:
                raise TempoFormatError("E_AGG", "record %d: '~sum.max' on a non-aggregate" % i)
            span["wait"] = int(wait_s, 36)
        if cpu_s is not None:
            span["cpu"] = int(cpu_s, 36)
        if flags_s is not None:
            for f in flags_s:
                if f not in FLAG_ORDER:
                    raise TempoFormatError("E_FLAG", "record %d: unknown flag %r" % (i, f))
            span["flags"] = "".join(f for f in FLAG_ORDER if f in flags_s)
        if attrs_s:
            attrs = {}
            for km in ATTR_RE.finditer(attrs_s):
                k = int(km.group(1), 36)
                if k >= len(names):
                    raise TempoFormatError("E_INDEX", "record %d attribute key %d out of range" % (i, k))
                attrs[names[k]] = decode_number(km.group(2))
            span["attrs"] = attrs
        if is_agg:
            agg = {"count": int(a_count, 36), "min": int(a_min, 36), "max": int(a_max, 36),
                   "extent": int(a_ext, 36), "maxAt": int(a_at, 36)}
            if agg["count"] < 1:
                raise TempoFormatError("E_AGG", "record %d: aggregate count 0" % i)
            if wait_s is not None:
                if wmax_s is None:
                    raise TempoFormatError("E_AGG", "record %d: aggregate wait needs sum.max" % i)
                agg["waitSum"] = int(wait_s, 36)
                agg["waitMax"] = int(wmax_s, 36)
            span["agg"] = agg
        path[depth] = span
        prev_depth = depth
        prev_agg = is_agg
        spans.append(span)
    return spans


TOP_KEYS = ["v", "unit", "wall", "folded", "dropped", "threads", "live", "truncated"]


def dump_json(doc):
    """The JSON form, one span per line (same layout as tools/tempo_ref.py)."""
    lines = ["{"]
    for k in TOP_KEYS:
        if k in doc:
            lines.append("  %s: %s," % (json.dumps(k), json.dumps(doc[k], ensure_ascii=False)))
    spans = doc.get("spans", [])
    if not spans:
        lines.append('  "spans": []')
    else:
        lines.append('  "spans": [')
        for i, s in enumerate(spans):
            sep = "," if i + 1 < len(spans) else ""
            lines.append("    " + json.dumps(s, ensure_ascii=False, separators=(",", ":")) + sep)
        lines.append("  ]")
    lines.append("}")
    return "\n".join(lines) + "\n"


# ======================================================================
# Encoder (FORMAT.md section 7, canonical form; mirrors tools/tempo_ref.py).
# Only needed to write a link for a trace that arrived as JSON.
# ======================================================================

def to_b36(n):
    if n < 0:
        raise ValueError("negative value cannot be encoded: %r" % n)
    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    out = []
    while True:
        n, r = divmod(n, 36)
        out.append(digits[r])
        if not n:
            return "".join(reversed(out))


def encode_name(name):
    out = []
    for byte in (name or "?").encode("utf-8"):
        if (0x30 <= byte <= 0x39 or 0x41 <= byte <= 0x5A or 0x61 <= byte <= 0x7A
                or byte == 0x2E or byte == 0x2D):
            out.append(chr(byte))
        elif byte == 0x20:
            out.append("_")
        else:
            out.append("%%%02X" % byte)
    return "".join(out)


def encode_number(v):
    if isinstance(v, int):
        return str(v)
    if v != v or v in (float("inf"), float("-inf")):
        return None
    s = ("%.6f" % v).rstrip("0").rstrip(".")
    return "0" if s in ("-0", "") else s


def encode(doc):
    """The JSON form (as normalize_doc returns it) -> canonical header value. ValueError if impossible."""
    spans = doc["spans"]
    if not spans:
        raise ValueError("a trace without spans has no header value")
    depth, stack = [], []
    for i, s in enumerate(spans):
        if i == 0:
            if s["thread"] != 0 or s["start"] != 0:
                raise ValueError("the root must start at 0 on thread 0")
            depth.append(0)
        else:
            while stack and stack[-1] != s["parent"]:
                stack.pop()
            if not stack:
                raise ValueError("span %d is not in pre-order" % i)
            depth.append(depth[s["parent"]] + 1)
            if depth[i] > MAX_DEPTH:
                raise ValueError("span %d is deeper than %d" % (i, MAX_DEPTH))
        stack.append(i)
    names = {}
    for s in spans:
        names.setdefault(s["name"] or "?", len(names))
    for s in spans:
        for k in s.get("attrs", {}):
            names.setdefault(k or "?", len(names))
    dropped = doc.get("dropped", 0)
    recs = []
    cur = [0] * (MAX_DEPTH + 2)
    for i, s in enumerate(spans):
        d = depth[i]
        delta = s["start"] - cur[d]
        if delta < 0:
            raise ValueError("span %d starts before its previous sibling or parent" % i)
        cur[d] = cur[d + 1] = s["start"]
        r = [to_b36(d), to_b36(names[s["name"] or "?"]), ".", to_b36(delta), ".", to_b36(s["dur"])]
        agg = s.get("agg")
        if i > 0 and s["thread"] != spans[s["parent"]]["thread"]:
            r.append("@_" if s["thread"] == -1 else "@" + to_b36(s["thread"]))
        if agg is not None:
            if "waitSum" in agg:
                r.append("~%s.%s" % (to_b36(agg["waitSum"]), to_b36(agg["waitMax"])))
        elif "wait" in s:
            r.append("~" + to_b36(s["wait"]))
        if "cpu" in s:
            r.append("*" + to_b36(s["cpu"]))
        if agg is not None:
            r.append("+" + ".".join(to_b36(agg[k]) for k in ("count", "min", "max", "extent", "maxAt")))
        if s.get("flags"):
            r.append("^" + "".join(f for f in FLAG_ORDER if f in s["flags"]))
        for k, val in s.get("attrs", {}).items():
            num = encode_number(val)
            if num is None:
                dropped += 1
            else:
                r.append(":%s=%s" % (to_b36(names[k or "?"]), num))
        recs.append("".join(r))
    out = ["v1"]
    if doc.get("wall") is not None:
        out.append("w=" + to_b36(doc["wall"]))
    if doc.get("folded", 0) or dropped:
        out.append("x=%s.%s" % (to_b36(doc.get("folded", 0)), to_b36(dropped)))
    if doc.get("live"):
        out.append("l=" + ".".join(to_b36(t) for t in doc["live"]))
    out.append("T=" + ":".join(encode_name(t) for t in doc["threads"]))
    out.append("N=" + ":".join(encode_name(n) for n in names))
    out.append("S=" + "/".join(recs))
    out.append("e=" + to_b36(len(recs)))
    return ";".join(out)


# ======================================================================
# Tempo-Link (FORMAT.md section 9; mirrors tools/tempo_ref.py)
# ======================================================================

DEFAULT_BASE = "https://dualuse.de/tempo/"
B64URL_RE = re.compile(r"^[A-Za-z0-9_-]*$")
MAX_INFLATED = 16 * 1024 * 1024


def pack_value(value, level=9):
    """A fragment parameter in the z. form: 'z.' + base64url(raw DEFLATE). Always this form, even
    where the plain one would be shorter, because terminals detect it as part of the URL."""
    co = zlib.compressobj(level, zlib.DEFLATED, -15)
    return "z." + base64.urlsafe_b64encode(co.compress(value.encode("utf-8")) + co.flush()).decode("ascii").rstrip("=")


def unpack_value(packed):
    """A fragment parameter -> the Tempo-Timing value it carries (not yet validated)."""
    p = strip_ws(packed)
    if not p:
        raise TempoFormatError("E_LINK", "empty trace parameter")
    if not p.startswith("z."):
        return re.sub(r"%([0-9A-Fa-f]{2})", lambda m: chr(int(m.group(1), 16)), p)
    s = p[2:]
    s = s[:-2] if s.endswith("==") else s[:-1] if s.endswith("=") else s
    if not B64URL_RE.match(s):
        bad = next(ch for ch in s if not B64URL_RE.match(ch))
        raise TempoFormatError("E_LINK", "character %r is not base64url" % bad)
    if len(s) % 4 == 1:
        raise TempoFormatError("E_LINK", "base64url length %d is impossible" % len(s))
    d = zlib.decompressobj(-15)
    try:
        out = d.decompress(base64.urlsafe_b64decode(s + "=" * (-len(s) % 4)), MAX_INFLATED + 1)
    except zlib.error as e:
        raise TempoFormatError("E_LINK", "payload is not raw DEFLATE (%s)" % e)
    if len(out) > MAX_INFLATED:
        raise TempoFormatError("E_LINK", "payload inflates to more than %d bytes" % MAX_INFLATED)
    if not d.eof:
        raise TempoFormatError("E_LINK", "DEFLATE stream is incomplete (link cut?)")
    if d.unused_data:
        raise TempoFormatError("E_LINK", "%d bytes follow the DEFLATE stream" % len(d.unused_data))
    return out.decode("utf-8", "replace")


def _params(text):
    out = {}
    for part in text.split("&"):
        k, eq, v = part.partition("=")
        if k and eq:
            out[k] = v                     # a repeated parameter: the last one wins
    return out


def link_params(url):
    """The parameters of a link: from the fragment when it carries t=, else from the query."""
    u, _, frag = strip_ws(url).partition("#")
    for params in (_params(frag), _params(u.partition("?")[2])):
        if params.get("t"):
            return params
    raise TempoFormatError("E_LINK", "link has no t= parameter in the fragment or the query")


def check_base(base):
    if not base or "#" in base or any(ch in WHITESPACE or ch == "," for ch in base):
        raise ValueError("--base must be a URL without '#', ',' or whitespace: %r" % base)
    return base


def encode_link(value, base=DEFAULT_BASE, compare=None, tab=None):
    url = check_base(base) + "#t=" + pack_value(strip_ws(value))
    if compare is not None:
        url += "&c=" + pack_value(strip_ws(compare))
    if tab:
        url += "&tab=" + tab
    return url


# ======================================================================
# JSON input: validation of the JSON form
# ======================================================================

def _int(v, what, lo=0):
    if isinstance(v, bool) or not isinstance(v, (int, float)) or v != v:
        raise TempoFormatError("E_JSON", "%s is not a number: %r" % (what, v))
    v = int(round(v))
    if v < lo:
        raise TempoFormatError("E_JSON", "%s out of range: %r" % (what, v))
    return v


def normalize_doc(obj):
    """Validate a JSON-form object and return a clean copy (FORMAT.md section 8)."""
    if not isinstance(obj, dict) or obj.get("v") != 1 or not isinstance(obj.get("spans"), list):
        raise TempoFormatError("E_JSON", "not a tempo object (needs \"v\": 1 and \"spans\")")
    if obj.get("unit", "us") != "us":
        raise TempoFormatError("E_JSON", "unit %r is not \"us\"" % obj.get("unit"))
    doc = {"v": 1, "unit": "us"}
    if obj.get("wall") is not None:
        doc["wall"] = _int(obj["wall"], "wall")
    doc["folded"] = _int(obj.get("folded", 0), "folded")
    doc["dropped"] = _int(obj.get("dropped", 0), "dropped")
    threads = obj.get("threads", [])
    if not isinstance(threads, list) or not all(isinstance(t, str) for t in threads):
        raise TempoFormatError("E_JSON", "threads must be a list of strings")
    threads = [t or "?" for t in threads] or ["?"]
    doc["threads"] = threads
    live = obj.get("live", [])
    if not isinstance(live, list):
        raise TempoFormatError("E_JSON", "live must be a list")
    doc["live"] = [_int(i, "live index") for i in live]
    for i in doc["live"]:
        if i >= len(threads):
            raise TempoFormatError("E_JSON", "live index %d out of range" % i)
    doc["truncated"] = bool(obj.get("truncated", False))
    spans = []
    for i, s in enumerate(obj["spans"]):
        if not isinstance(s, dict):
            raise TempoFormatError("E_JSON", "span %d is not an object" % i)
        if s.get("id", i) != i:
            raise TempoFormatError("E_JSON", "span %d has id %r" % (i, s.get("id")))
        parent = _int(s.get("parent", -1), "span %d parent" % i, -1)
        if (i == 0) != (parent == -1) or parent >= i:
            raise TempoFormatError("E_JSON", "span %d has parent %d" % (i, parent))
        if parent >= 0 and "agg" in spans[parent]:
            raise TempoFormatError("E_JSON", "span %d is a child of an aggregate" % i)
        name = s.get("name")
        if name is None or name == "":
            name = "?"
        if not isinstance(name, str):
            raise TempoFormatError("E_JSON", "span %d name is not a string" % i)
        thread = _int(s.get("thread", 0 if i == 0 else spans[parent]["thread"]), "span %d thread" % i, -1)
        if thread >= len(threads):
            raise TempoFormatError("E_JSON", "span %d thread %d out of range" % (i, thread))
        out = {"id": i, "parent": parent, "name": name,
               "start": _int(s.get("start", 0), "span %d start" % i),
               "dur": _int(s.get("dur", 0), "span %d dur" % i), "thread": thread}
        if thread == -1 and "agg" not in s:
            raise TempoFormatError("E_JSON", "span %d: thread -1 outside an aggregate" % i)
        if s.get("wait") is not None and "agg" not in s:
            out["wait"] = _int(s["wait"], "span %d wait" % i)
        if s.get("cpu") is not None:
            out["cpu"] = _int(s["cpu"], "span %d cpu" % i)
        flags = s.get("flags") or ""
        if not isinstance(flags, str) or any(f not in FLAG_ORDER for f in flags):
            raise TempoFormatError("E_JSON", "span %d has bad flags %r" % (i, flags))
        if flags:
            out["flags"] = "".join(f for f in FLAG_ORDER if f in flags)
        attrs = s.get("attrs")
        if attrs:
            if not isinstance(attrs, dict):
                raise TempoFormatError("E_JSON", "span %d attrs is not an object" % i)
            clean = {}
            for k, val in attrs.items():
                if isinstance(val, bool) or not isinstance(val, (int, float)):
                    raise TempoFormatError("E_JSON", "span %d attribute %r is not a number" % (i, k))
                clean[k or "?"] = val
            out["attrs"] = clean
        agg = s.get("agg")
        if agg is not None:
            if not isinstance(agg, dict):
                raise TempoFormatError("E_JSON", "span %d agg is not an object" % i)
            a = {}
            for k in ("count", "min", "max", "extent", "maxAt"):
                a[k] = _int(agg.get(k, 0), "span %d agg.%s" % (i, k))
            if a["count"] < 1:
                raise TempoFormatError("E_JSON", "span %d: aggregate count 0" % i)
            if agg.get("waitSum") is not None:
                a["waitSum"] = _int(agg["waitSum"], "span %d agg.waitSum" % i)
                a["waitMax"] = _int(agg.get("waitMax", 0), "span %d agg.waitMax" % i)
            out["agg"] = a
        spans.append(out)
    doc["spans"] = spans
    return doc


# ======================================================================
# Input extraction
# ======================================================================

VALUE_CHARS = frozenset(ALPHABET | frozenset(WHITESPACE))
# what a link may consist of: printable ASCII except the characters a URL never holds unescaped
LINK_CHARS = frozenset(chr(c) for c in range(0x21, 0x7F)) - frozenset('"<>\\`{|},') | frozenset(WHITESPACE)
HEADER_RE = re.compile(r"^[ \t]*(tempo-timing|tempo-link)[ \t]*:(.*)$", re.I)
FIELD_LINE_RE = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+:[ \t]+\S")
COMPLETE_RE = re.compile(r";e=[0-9a-z]+$")
VALUE_START_RE = re.compile(r"(?m)^[ \t]*(?=v1;)")
BARE_RE = re.compile(r"(?:^|(?<=[^0-9A-Za-z./:;=@~*+^_%-]))v1;")
# a URL (or a bare fragment) whose fragment or query has a t= parameter: a Tempo-Link
# (the fragment form; the query form only with a t= that starts like a packed value)
LINK_TOKEN_RE = re.compile(r"[^\s\"'<>`{|}\\,]*(?:#(?:[^\s\"'<>`{|}\\,#&]*&)*t="
                           r"|\?(?:[^\s\"'<>`{|}\\,#&]*&)*t=(?=z\.|v1))[^\s\"'<>`{|}\\,]*")


class InputError(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, "%s: %s" % (code, message))
        self.code = code


def link_complete(url):
    """True when a link (or what a wrapped line left of it) decodes to complete values."""
    try:
        p = link_params(url)
        return all(COMPLETE_RE.search(strip_ws(unpack_value(p[k]))) for k in ("t", "c") if p.get(k))
    except TempoFormatError:
        return False


def _header_values(lines):
    """Tempo-Timing and Tempo-Link header lines, with folded or wrapped continuation lines.

    Returns (kind, payload, alt) triples: kind "header" or "link". Within one response
    (a block that starts at an HTTP/ status line) Tempo-Timing wins; the i-th Tempo-Link
    then becomes `alt` of the i-th Tempo-Timing value, to be checked for agreement.
    """
    blocks = [([], [])]                      # per response: (timing values, links)
    i = 0
    while i < len(lines):
        if lines[i].startswith("HTTP/"):
            blocks.append(([], []))
        m = HEADER_RE.match(lines[i])
        i += 1
        if not m:
            continue
        is_link = m.group(1).lower() == "tempo-link"
        chars = LINK_CHARS if is_link else VALUE_CHARS
        value = m.group(2)
        while i < len(lines):
            nxt = lines[i]
            if not nxt.strip():
                break
            folded = nxt[:1] in (" ", "\t")
            if not folded:
                if link_complete(value) if is_link else COMPLETE_RE.search(strip_ws(value)):
                    break
                if FIELD_LINE_RE.match(nxt) or nxt.startswith("HTTP/") or nxt.lstrip().startswith("v1;"):
                    break
            if any(ch not in chars for ch in nxt):
                break
            value += nxt
            i += 1
        blocks[-1][1 if is_link else 0].append(value)
    out = []
    for timing, links in blocks:
        if timing:
            out.extend(("header", v, links[k] if k < len(links) else None) for k, v in enumerate(timing))
        else:
            out.extend(("link", v, None) for v in links)
    return out


def _bare_links(lines):
    """Links anywhere in the text (a log line, a pasted URL); a link that ends its line
    and is not complete yet continues on the next lines, as a terminal wraps it."""
    out = []
    for li, line in enumerate(lines):
        for m in LINK_TOKEN_RE.finditer(line):
            url = m.group(0).rstrip(".)]!?")
            j = li + 1
            while m.end() == len(line.rstrip()) and j < len(lines) and not link_complete(url):
                nxt = lines[j].strip()
                if (not nxt or any(ch in WHITESPACE or ch not in LINK_CHARS for ch in nxt)
                        or "#" in nxt or "://" in nxt or FIELD_LINE_RE.match(nxt)):
                    break
                url += nxt
                j += 1
            out.append(url.rstrip(".)]!?"))
    return out


def _find_tempo(obj, out):
    """Collect tempo objects (and tempo header strings) anywhere in a JSON value."""
    if isinstance(obj, dict):
        if obj.get("v") == 1 and isinstance(obj.get("spans"), list):
            out.append(("json", obj))
            return
        for k, v in obj.items():
            if k.lower() == "tempo" and isinstance(v, str) and strip_ws(v).startswith("v1;"):
                out.append(("header", v))
            else:
                _find_tempo(v, out)
    elif isinstance(obj, list):
        for v in obj:
            _find_tempo(v, out)


def _json_candidates(text):
    found = []
    dec = json.JSONDecoder()
    pos = 0
    n = len(text)
    while pos < n:
        # a JSON value starts at the beginning of a line (whole body, NDJSON, curl -i body)
        j = pos
        while j < n and text[j] in " \t\r":
            j += 1
        if j < n and text[j] in "{[":
            try:
                obj, end = dec.raw_decode(text, j)
            except ValueError:
                obj, end = None, None
            if end is not None:
                _find_tempo(obj, found)
                pos = end
                continue
        nl = text.find("\n", pos)
        if nl < 0:
            break
        pos = nl + 1
    return found


def extract(text):
    """Find the traces in an input text: a list of (kind, payload, alt) with kind "header"
    (a Tempo-Timing value), "link" (a Tempo-Link URL) or "json" (a dict); alt is a
    Tempo-Link that came with a Tempo-Timing value in the same response, or None."""
    if text.startswith("\ufeff"):
        text = text[1:]
    found = _json_candidates(text)
    if found:
        return [(kind, payload, None) for kind, payload in found]
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    values = _header_values(lines)
    if values:
        return values
    links = [("link", u, None) for u in _bare_links(lines)]
    stripped = text.strip(WHITESPACE)
    if not links and (stripped.startswith("v1;") or not BARE_RE.search(text)):
        if stripped[:1] in ("{", "["):
            return []
        # the input is the value itself: decode all of it strictly; several values
        # may follow each other, one per line (continuation lines are joined)
        return [("header", c, None) for c in VALUE_START_RE.split(text) if c.strip(WHITESPACE)] \
            or [("header", text, None)]
    out = links
    starts = [m.start() for m in BARE_RE.finditer(text)]
    for k, st in enumerate(starts):
        e = starts[k + 1] if k + 1 < len(starts) else len(text)
        j = st
        while j < e and text[j] in VALUE_CHARS:
            if text[j] in WHITESPACE and COMPLETE_RE.search(strip_ws(text[st:j])):
                break
            j += 1
        out.append(("header", text[st:j], None))
    return out


def _decode_candidate(kind, payload):
    """(doc, value, packed c= or None) of one candidate; value is None for JSON."""
    if kind == "json":
        return normalize_doc(payload), None, None
    if kind == "link":
        params = link_params(payload)
        value = strip_ws(unpack_value(params["t"]))
        return decode(value), value, params.get("c") or None
    value = strip_ws(payload)
    return decode(value), value, None


def load_text(text, label, warn=None):
    """All traces of one input as a list of (label, Trace or TempoFormatError).

    A Tempo-Link next to a Tempo-Timing value is only checked: the value wins, and
    `warn` (a function taking a message) hears about a link that disagrees with it.
    """
    cands = extract(text)
    if not cands:
        return [(label, InputError("E_INPUT", "no Tempo-Timing value, Tempo-Link or tempo JSON found"))]
    out = []
    for k, (kind, payload, alt) in enumerate(cands):
        lab = label if len(cands) == 1 else "%s#%d" % (label, k + 1)
        try:
            doc, value, compare = _decode_candidate(kind, payload)
        except TempoFormatError as e:
            if alt is None:
                out.append((lab, e))
                continue
            try:     # Tempo-Timing rejected: fall back to the link of the same response
                doc, value, compare = _decode_candidate("link", alt)
            except TempoFormatError:
                out.append((lab, e))
                continue
            if warn:
                warn("%s: Tempo-Timing rejected (%s); using Tempo-Link" % (lab, e))
            alt = None
        if alt is not None and warn:
            try:
                if _decode_candidate("link", alt)[0] != doc:
                    warn("%s: Tempo-Link and Tempo-Timing disagree; using Tempo-Timing" % lab)
            except TempoFormatError as e:
                warn("%s: Tempo-Link ignored (%s); using Tempo-Timing" % (lab, e))
        try:
            t = Trace(doc, lab)
        except TempoFormatError as e:
            out.append((lab, e))
            continue
        t.value, t.link_compare = value, compare
        out.append((lab, t))
    return out


