THREAD_N_RE = re.compile(r"^Thread-\d+$")
POOL_RE = re.compile(r"^(.+?)-\d+$")


def pool_of(thread_name):
    """Pool of a thread: the name without a trailing -<digits>; Thread-N stays alone."""
    if THREAD_N_RE.match(thread_name):
        return thread_name
    m = POOL_RE.match(thread_name)
    return m.group(1) if m else thread_name


class Span(object):
    __slots__ = ("id", "parent", "name", "start", "dur", "thread", "wait", "cpu", "flags",
                 "attrs", "agg", "children", "depth", "path", "key", "handoff", "not_run",
                 "run_start", "end", "self_time", "pool", "lane")

    def label(self):
        return "%s ×%d" % (self.name, self.agg["count"]) if self.agg else self.name

    @property
    def wait_max(self):
        if self.agg:
            return self.agg.get("waitMax", 0)
        return self.wait

    @property
    def offcpu(self):
        if self.cpu is None:
            return None
        return max(0, self.dur - self.cpu)


class Trace(object):
    def __init__(self, doc, label="-"):
        self.doc = doc
        self.label = label
        self.threads = list(doc.get("threads") or ["?"])
        self.wall = doc.get("wall")
        self.folded = doc.get("folded", 0)
        self.dropped = doc.get("dropped", 0)
        self.live = list(doc.get("live") or [])
        self.truncated = bool(doc.get("truncated"))
        self.spans = []
        for d in doc["spans"]:
            s = Span()
            s.id = d["id"]
            s.parent = self.spans[d["parent"]] if d["parent"] >= 0 else None
            s.name = d["name"]
            s.start = d["start"]
            s.dur = d["dur"]
            s.thread = d["thread"]
            s.cpu = d.get("cpu")
            s.flags = d.get("flags", "")
            s.attrs = d.get("attrs") or {}
            s.agg = d.get("agg")
            s.children = []
            if s.agg:
                s.handoff = "waitSum" in s.agg
                s.wait = s.agg.get("waitSum", 0)
            else:
                s.handoff = "wait" in d
                s.wait = d.get("wait", 0)
            s.not_run = s.handoff and ("n" in s.flags or ("c" in s.flags and s.dur == 0))
            s.run_start = s.start + s.wait if (s.handoff and not s.agg) else s.start
            s.end = s.start + s.agg["extent"] if s.agg else s.run_start + s.dur
            if s.not_run and not s.agg:
                s.end = s.start + s.wait
            if s.parent is None:
                s.depth = 0
                s.path = s.name
                s.key = ""
            else:
                s.parent.children.append(s)
                s.depth = s.parent.depth + 1
                s.key = s.name if s.parent.parent is None else s.parent.key + "/" + s.name
                s.path = s.key
            self.spans.append(s)
        self.root = self.spans[0] if self.spans else None
        for s in self.spans:
            s.self_time = s.dur if s.agg else max(0, s.dur - sum(
                c.dur for c in s.children if self._nested(c, s)))
        self._assign_pools()
        self.end = max([s.end for s in self.spans] or [0])

    @staticmethod
    def _nested(c, s):
        """A child whose run time is part of its parent's run time on the same lane."""
        return (c.thread == s.thread and c.thread >= 0 and not c.handoff and not c.not_run)

    def _assign_pools(self):
        by_key = {}
        by_name = {}
        for s in self.spans:
            if s.thread >= 0 and not s.not_run:
                p = pool_of(self.threads[s.thread])
                by_key.setdefault(s.key, {}).setdefault(p, 0)
                by_key[s.key][p] += 1
                by_name.setdefault(s.name, {}).setdefault(p, 0)
                by_name[s.name][p] += 1

        def guess(s):
            # prefer a pool that is not the parent's own (where it would sit nominally)
            for table in (by_key.get(s.key), by_name.get(s.name)):
                if table:
                    own = pool_of(self.threads[s.parent.thread]) if (s.parent and s.parent.thread >= 0) else None
                    best = sorted(table.items(), key=lambda kv: (kv[0] == own and s.not_run, -kv[1], kv[0]))
                    return best[0][0]
            return "?"

        for s in self.spans:
            if s.not_run:
                s.pool = guess(s)
                s.lane = ("queued", s.pool)
            elif s.thread < 0:
                s.pool = guess(s)
                s.lane = ("mixed", s.pool)
            else:
                s.pool = pool_of(self.threads[s.thread])
                s.lane = ("t", s.thread)

    def thread_label(self, s):
        if s.not_run:
            return "-"
        if s.thread < 0:
            return s.pool + "-*"
        return self.threads[s.thread]

    def is_task(self, s):
        """A unit of work this request handed to a pool (or ran on another thread)."""
        if s.parent is None:
            return False
        if s.handoff:
            return True
        return s.thread != s.parent.thread

    def pool_order(self):
        order = []
        for t in self.threads:
            p = pool_of(t)
            if p not in order:
                order.append(p)
        for s in self.spans:
            if s.pool not in order:
                order.append(s.pool)
        return order


